{
  "name": "home-organizer",
  "version": "0.2.22",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.21.x",
    "npm": "12.0.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:tools": "esbuild scripts/migrate.ts scripts/seed.ts src/worker.ts --bundle --platform=node --format=esm --outdir=dist --external:@node-rs/argon2 --external:@libsql/client",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.0.0",
    "next": "^16.0.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
